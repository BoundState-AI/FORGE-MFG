# FORGE-MFG environment configuration
# Copy to .env and edit for local development

FORGE_ENV=local
FORGE_DEBUG=true
FORGE_LOG_LEVEL=DEBUG
FORGE_AUTH_MODE=local

# Database
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge

# Cognito (not required in local mode)
FORGE_COGNITO_USER_POOL_ID=
FORGE_COGNITO_REGION=us-gov-west-1
FORGE_COGNITO_APP_CLIENT_ID=

# CORS
FORGE_CORS_ORIGINS=["http://localhost:3000"]

# S3 (LocalStack for local dev)
FORGE_S3_ENDPOINT_URL=http://localhost:4566
FORGE_S3_BUCKET_DOCUMENTS=forge-documents
FORGE_S3_BUCKET_EVIDENCE=forge-evidence
FORGE_S3_BUCKET_AUDIT=forge-audit

# Feature flags (conditional scope)
FORGE_FEATURE_ORACLE_CHAT=false
FORGE_FEATURE_CPM_SCHEDULING=false
FORGE_FEATURE_WORM_REPLICATION=false
